{
  "name": "automation-kiotviet",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework for KiotViet",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:single": "playwright test --grep",
    "report": "playwright show-report",
    "pretest": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:generate:html": "allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:report": "npm run test && npm run allure:generate && npm run allure:open",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.3.0"
  }
}
